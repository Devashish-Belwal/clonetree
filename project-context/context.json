    "contents": "\"use client\";\r\n\r\nimport { ChevronRight } from \"lucide-react\";\r\n\r\ninterface MobileMenuItemProps {\r\n    label: string;\r\n    hasArrow?: boolean;\r\n    onClick?: () => void;\r\n}\r\n\r\nexport default function MobileMenuItem({\r\n    label,\r\n    hasArrow = false,\r\n    onClick,\r\n}: MobileMenuItemProps) {\r\n    return (\r\n        <button\r\n            onClick={onClick}\r\n            className=\"\r\n        flex\r\n        h-16\r\n        w-full\r\n        items-center\r\n        justify-between\r\n        px-6\r\n        text-left\r\n        text-xl\r\n        font-medium\r\n        text-black\r\n        transition-colors\r\n        hover:bg-neutral-100\r\n      \"\r\n        >\r\n            <span>{label}</span>\r\n\r\n            {hasArrow && (\r\n                <ChevronRight className=\"size-5 text-neutral-500\" />\r\n            )}\r\n        </button>\r\n    );\r\n}"

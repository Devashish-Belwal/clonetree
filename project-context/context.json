    "contents": "import { Category } from \"@/types/navigation\";\r\nimport Image from 'next/image'\r\n\r\ninterface ContentPanelProps {\r\n  category: Category;\r\n  // className: string\r\n}\r\n\r\nexport default function ContentPanel({\r\n  category,\r\n  // className\r\n}: ContentPanelProps) {\r\n  return (\r\n    <div className=\"flex flex-col border-r p-8\">\r\n   {/* <div className={className + ' ' + \"flex flex-col border-r p-8\"}> */}\r\n      <div className=\"flex flex-col gap-2\">\r\n        {category.subItems.map((item) => (\r\n          <button\r\n            key={item.title}\r\n            className=\"\r\n              group\r\n              flex\r\n              flex-col\r\n              text-left\r\n              rounded-2xl\r\n              py-3\r\n              px-4\r\n              transition-all\r\n              duration-200\r\n              hover:bg-neutral-100\r\n            \"\r\n          >\r\n\r\n            <h3 className=\"font-semibold\">\r\n              {item.title}\r\n            </h3>\r\n\r\n            <p className=\"mt-1 text-sm text-neutral-500\">\r\n              {item.description}\r\n            </p>\r\n          </button>\r\n        ))}\r\n      </div>\r\n\r\n      {category.footer && (\r\n        <div className=\"pt-6 px-4 mt-8\">\r\n          <h4 className=\"font-semibold\">\r\n            {category.footer.title}\r\n          </h4>\r\n\r\n          <p className=\"mt-2 text-sm text-neutral-500\">\r\n            {category.footer.description}\r\n          </p>\r\n\r\n          <div\r\n            className=\"flex flex-row flex-wrap gap-3 pt-4\"\r\n          >\r\n            {category.footer.socialIcons.map((icon) => (\r\n              <div\r\n                key={icon.platform}\r\n                className=\"bg-gray-300/40 p-3 rounded-xl\"\r\n              >\r\n                <Image\r\n                  alt=\"\"\r\n                  src={icon.icon}\r\n                  // src={\"/navigation/socials/instagram.svg\"}\r\n                  width={16}\r\n                  height={16}\r\n                />\r\n                {/* {icon.icon} */}\r\n              </div>\r\n            ))}\r\n          </div>\r\n\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}"

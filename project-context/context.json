    "contents": "\"use client\";\r\n\r\nimport { ChevronDown } from \"lucide-react\";\r\n\r\ninterface MobileAccordionItemProps {\r\n  title: string;\r\n  isOpen: boolean;\r\n  onToggle: () => void;\r\n  children?: React.ReactNode;\r\n}\r\n\r\nexport default function MobileAccordionItem({\r\n  title,\r\n  isOpen,\r\n  onToggle,\r\n  children,\r\n}: MobileAccordionItemProps) {\r\n  return (\r\n    <div className=\"border-b border-neutral-200\">\r\n      <button\r\n        onClick={onToggle}\r\n        className=\"\r\n          flex\r\n          h-16\r\n          w-full\r\n          items-center\r\n          justify-between\r\n          px-6\r\n          text-left\r\n          text-xl\r\n          font-medium\r\n          text-black\r\n        \"\r\n      >\r\n        <span>{title}</span>\r\n\r\n        <ChevronDown\r\n          className={`size-5 transition-transform duration-200 ${\r\n            isOpen ? \"rotate-180\" : \"\"\r\n          }`}\r\n        />\r\n      </button>\r\n\r\n      {isOpen && (\r\n        <div className=\"pb-2\">\r\n          {children}\r\n        </div>\r\n      )}\r\n    </div>\r\n  );\r\n}\r\n"
